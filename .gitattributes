# Normaliza fim de linha: LF no repositório, nativo no working tree.
# Sem isso, um repo usado em Windows e Linux gera diff de arquivo inteiro.
* text=auto eol=lf

# Scripts que precisam de CRLF no Windows
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binários
*.png   binary
*.jpg   binary
*.ico   binary
*.icns  binary
*.pdf   binary
*.sqlite binary
*.db    binary

# Código gerado: não polui o diff da PR, mas continua versionado
packages/contracts/generated/** linguist-generated=true
